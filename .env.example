# MySQL and Redis
MYSQL_ROOT_PASSWORD=research
MYSQL_DATABASE=research
MYSQL_USER=research
MYSQL_PASSWORD=research
DATABASE_URL=mysql+asyncmy://research:research@127.0.0.1:3306/research?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# API
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Worker
WORKER_CONCURRENCY=2
RUN_LEASE_SECONDS=30
RUN_LEASE_REFRESH_SECONDS=10
WORKER_POLL_SECONDS=1

# Model and search
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
WEB_SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# Local development storage
OBJECT_STORE=local
OBJECT_ROOT=../data/objects
SANDBOX_MODE=local

# Uploads
UPLOAD_MAX_FILES=10
UPLOAD_MAX_BYTES=26214400
UPLOAD_TOTAL_MAX_BYTES=104857600

