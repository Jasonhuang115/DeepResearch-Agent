# Shared
MYSQL_ROOT_PASSWORD=research
MYSQL_DATABASE=research
MYSQL_USER=research
MYSQL_PASSWORD=research

# Go carrier
HTTP_ADDR=:8080
MYSQL_DSN=research:research@tcp(127.0.0.1:3306)/research?charset=utf8mb4&parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:9092
JWT_SECRET=dev-change-me-please-use-32-bytes-min
INSTANCE_ID=local-1
CORS_ORIGINS=http://localhost:5173
QUEUED_TIMEOUT_SEC=60s
RUNNING_STALE_SEC=120s
# Subagent runs skip the 120s stale sweep. This only fails a run whose process died.
SUBAGENT_ORPHAN_SEC=7200s
JOURNAL_RETENTION_DAYS=168h

# Agent
AGENT_HTTP_ADDR=127.0.0.1:8001
KAFKA_COMMANDS_TOPIC=research.run.commands
KAFKA_EVENTS_TOPIC=research.run.events
KAFKA_WAKES_TOPIC=research.subagent.wakes
KAFKA_GROUP=agent
AGENT_WORKSPACE=auto
# AGENT_WORKSPACE_ROOT=/tmp/research-workspaces
# E2B_API_KEY=
# E2B_TIMEOUT_SEC=3600
# AGENT_SANDBOX_REDIS_TTL_SEC=3300
WEB_SEARCH_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
# OPENAI_THINKING=enabled
# OPENAI_REASONING_EFFORT=high
# TAVILY_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5
# AGENT_FETCH_TIMEOUT_SEC=20
# AGENT_FETCH_MAX_BYTES=2000000
# Shared by Go and the agent (relative data/uploads resolves to the repo folder).
# UPLOAD_DIR=data/uploads
# UPLOAD_MAX_BYTES=20971520
# UPLOAD_MAX_FILES=5

# Context packing and tool overflow
# AGENT_TOOL_RESULT_MAX_CHARS=10000
# AGENT_CONTEXT_INPUT_BUDGET=100000
# Hidden continuations after finish_reason=length. Not extra chat messages.
# AGENT_MAX_OUTPUT_CONTINUATIONS=2
# AGENT_KEEPALIVE_SEC=60

# Durable memory (Aliyun OSS). Leave unset to use local fake disk at AGENT_DURABLE_ROOT.
# AGENT_DURABLE_ROOT=data/workspaces
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_PREFIX=tenants/

# Opik traces (developer only). Leave the key unset to skip tracing.
# OPIK_API_KEY=
# Opik_key= is accepted when OPIK_API_KEY is unset.
# OPIK_WORKSPACE=jasonhuang115
# OPIK_PROJECT_NAME=deep-research
# OPIK_URL_OVERRIDE=

# Go: idle conversation prefix GC (7 days)
# WORKSPACE_RETENTION=168h
# DURABLE_ROOT=data/workspaces
